# ---------------------------------------------------------------------------
# AI Capsule - environment variables
# Copy this file to ".env" for local development and fill in real values.
# NEVER commit the real ".env" file or any real secret to Git.
# On Render, set these in the service's "Environment" tab instead of a file.
# ---------------------------------------------------------------------------

# Port the Express server listens on (Render provides its own PORT automatically).
PORT=3000

# Node environment. Use "production" on the cloud so the app serves the built
# React client and sets Secure cookies. Use "development" locally.
NODE_ENV=development

# Secret used to SIGN and VERIFY the application JWT.
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# How long the application JWT stays valid.
JWT_EXPIRES_IN=7d

# --- GitHub OAuth application credentials ---
# Create an OAuth App at https://github.com/settings/developers
# The callback URL you register there must match OAUTH_CALLBACK_URL below.
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

# The full, public callback URL registered on the GitHub OAuth App.
# Local:  http://localhost:3000/auth/github/callback
# Render: https://YOUR-APP.onrender.com/auth/github/callback
OAUTH_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Where to send the browser after a successful login (the protected dashboard).
# Leave as "/dashboard" for the single-service setup.
POST_LOGIN_REDIRECT=/dashboard

# Absolute or relative path to the SQLite database file.
# On Render the local filesystem is ephemeral (see README).
DATABASE_FILE=./data/ai-capsule.sqlite
